{
  "lspServers": {
    "typescript": {
      "command": "npx",
      "args": ["--no-install", "typescript-language-server", "--stdio"],
      "fileExtensions": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    }
  }
}
